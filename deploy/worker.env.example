# Compose removes the outer single quotes and preserves $, #, and backslashes literally.
GETRECEIPT_API_TOKEN='replace-with-at-least-48-random-characters'
GETRECEIPT_OWNER_ID='replace-with-a-stable-random-owner-id'
GETRECEIPT_PROVIDER_CREDENTIALS_JSON='{"epos":{"login_id":"set-in-secret-manager","password":"set-in-secret-manager"},"commufa":{"login_id":"set-in-secret-manager","password":"set-in-secret-manager"},"webbilling":{"d_account_id":"set-in-secret-manager","password":"set-in-secret-manager"}}'
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"replace","private_key_id":"replace","private_key":"replace","client_email":"replace","client_id":"replace","token_uri":"https://oauth2.googleapis.com/token"}'
GETRECEIPT_MICROSOFT_CLIENT_ID=replace-with-application-client-id
GETRECEIPT_MICROSOFT_CLIENT_SECRET='replace-with-client-secret'
# Register this exact app-root URI, including the trailing slash, for delegated Graph OAuth.
GETRECEIPT_MICROSOFT_REDIRECT_URI=https://get-receipt.streamlit.app/
GETRECEIPT_MICROSOFT_TENANT=consumers
GETRECEIPT_TOKEN_ENCRYPTION_KEY='replace-with-fernet-key'
GETRECEIPT_DATABASE_PATH=/var/lib/getreceipt/jobs.sqlite3
GETRECEIPT_PROFILE_ROOT=/var/lib/getreceipt/profiles
GETRECEIPT_DOWNLOAD_ROOT=/var/lib/getreceipt/downloads
GETRECEIPT_INSTANCE_LOCK_PATH=/var/lib/getreceipt/worker.instance.lock
# Verified online snapshots are stored under
# /var/lib/getreceipt/.sqlite-backups with owner-only permissions.
GETRECEIPT_BACKUP_RETENTION_COUNT=14
GETRECEIPT_BACKUP_INTERVAL_SECONDS=21600
GETRECEIPT_BACKUP_RETRY_SECONDS=60
GETRECEIPT_BACKUP_FATAL_FAILURES=3
